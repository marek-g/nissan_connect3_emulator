[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\FC_TEA\APP_CONFIG]
; `scd_s32GetThreadConfiguration` (PROCNAV `0x34f71a`) reads the watchdog ms-per-tick
; directly under the app's APP_CONFIG key after the thread PRI O/STCK (the
; APP_CONFIG/WDG sub-key it tries first falls back to this value). A miss fails TEA's
; bOnInit -> the app-19 adapter stays INITIALIZED and rejects GPS class-0x45 at the
; state gate. Value follows the TIMA bring-up default (2500 ms).
"WDG_MSPERTICK"=dword:000009c4

[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\FC_TEA\SERVICES\FC_TEA]
"SERVICEID"=dword:00000013

[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\FC_STAT\AIF_CONFIG]
"MSG_COUNT_INTERMEDIATE_MBX"=dword:00000050
"WATCHDOG_INTERVALL"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\FC_STAT\APP_CONFIG]
; `scd_s32GetThreadConfiguration` (PROCNAV `0x34f71a`) reads these three values under
; the app's APP_CONFIG key while resolving a thread config; any miss zeroes the
; config and fails `rtf::tclComponent::s32SetupThreads` (-1), which makes STAT's
; bOnInit fail and the CCA adapter stuck in INITIALIZED. Values follow the TIMA
; bring-up defaults seen in the trace output (ms-per-tick 2500, 120/900 ticks).
"WDG_MSPERTICK"=dword:000009c4
"WTICKS"=dword:00000078
"MAXWTICKS"=dword:00000384

[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\FC_STAT\SERVICES\FC_STAT]
"SERVICEID"=dword:00000016

[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\WDB\AIF_CONFIG]
"MSG_COUNT_INTERMEDIATE_MBX"=dword:00000050
"WATCHDOG_INTERVALL"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\WDB\APP_CONFIG]

[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\WDB\SERVICES\WDB]
"SERVICEID"=dword:00000017

[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\FC_LBS\AIF_CONFIG]
"MSG_COUNT_INTERMEDIATE_MBX"=dword:00000050
"WATCHDOG_INTERVALL"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\FC_LBS\APP_CONFIG]
"ON_TENGINE"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\FC_LBS\SERVICES\FC_LBS]
"SERVICEID"=dword:0000011c

; Per-thread launch configuration (`scd_s32GetThreadConfiguration` 0x34f2d2 family opens
; <app>\APP_THREAD and queries <name>_PRIO/<name>_STCK; NAVI asks for 'AE' first and the
; components follow with their dynamic workers). Priorities mirror DAPIAPP's table (0x4b,
; 10 KiB stacks) - any runnable value works for bring-up.

[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\NAVAPP\APP_THREAD]
"AE_PRIO"=dword:0000004b
"AE_STCK"=dword:00002710
"AB_PRIO"=dword:0000004b
"AB_STCK"=dword:00002710
"DYN1_PRIO"=dword:0000004b
"DYN1_STCK"=dword:00002710
