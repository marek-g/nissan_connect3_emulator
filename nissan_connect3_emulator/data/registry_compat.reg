[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\FC_TEA\APP_THREAD]
; TEA_tclApplication::s32InitializeComponents -> component "TEA" -> rGetThreadConfig
; (appId 19). `scd_s32GetThreadConfiguration` builds `<AppName>_TASK1_<SUFFIX>` from
; the app id's registry name, so the values are TEA_TASK1_PRIO/_STCK plus the
; watchdog pair. A miss fails TEA's bOnInit and the app-19 adapter stays in
; INITIALIZED, rejecting the GPS class-0x45 messages at the state gate.
"TEA_TASK1_PRIO"=dword:0000004b
"TEA_TASK1_STCK"=dword:00002710
"TEA_TASK1_WTICKS"=dword:00000078
"TEA_TASK1_MAXWTICKS"=dword:00000384
"AE_PRIO"=dword:0000004b
"AE_STCK"=dword:00002710
"AB_PRIO"=dword:0000004b
"AB_STCK"=dword:00002710
"DYN1_PRIO"=dword:0000004b
"DYN1_STCK"=dword:00002710
"DYN2_PRIO"=dword:0000004b
"DYN2_STCK"=dword:00002710

[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\FC_STAT\APP_THREAD]
"AE_PRIO"=dword:0000004b
"AE_STCK"=dword:00002710
"AB_PRIO"=dword:0000004b
"AB_STCK"=dword:00002710
"DYN1_PRIO"=dword:0000004b
"DYN1_STCK"=dword:00002710
"DYN2_PRIO"=dword:0000004b
"DYN2_STCK"=dword:00002710
; STAT_tclComponent::s32Initialize -> rtf s32SetupThreads queries STAT_TASK1 through
; scd_s32GetThreadConfiguration; a miss returns a zero config and bOnInit fails (-1).
; The watchdog pair is the thread name + `_WTICKS`/`_MAXWTICKS` (`%s_%s` built in
; PROCNAV `0x34f6c8`), read from the very same APP_THREAD key.
"STAT_TASK1_PRIO"=dword:0000004b
"STAT_TASK1_STCK"=dword:00002710
"STAT_TASK1_WTICKS"=dword:00000078
"STAT_TASK1_MAXWTICKS"=dword:00000384

; STAT_tclThread.cpp gates its three breadcrumb accessor FUs on ACTIVATE_*
; dwords under APP_CONFIG\STAT_TASK1 (strings 0x115308/0x115378/0x115390).
; Without them no accessor is instantiated.  Each accessor then opens its own
; node below STAT_TASK1 (STAT_tclDRAccessor / GMBC / MM sources open
; `APP_CONFIG\STAT_TASK1\<NAME>`, strings 0x138430/0x139e80/0x13ae50) and reads
; its thresholds; value contents follow the file names they drive
; (bread_crumb[_dr|_mm].{header,content}.dat under /dev/ffs/Statistics).
[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\FC_STAT\APP_CONFIG\STAT_TASK1]
"ACTIVATE_GMBC_ACCESSOR"=dword:00000001
"ACTIVATE_DR_ACCESSOR"=dword:00000001
"ACTIVATE_MM_ACCESSOR"=dword:00000001
; r352: accessor init also queries this switch under STAT_TASK1 itself; 0 keeps
; the "bread_crumb*.dat" files at their built-in /dev/ffs + /dev/card1 paths.
"SET_MARINA_FILE_PATHES"=dword:00000000

; r352: the accessor FUs query these threshold dwords per node (names carry
; their units).  r355: the accessors sanity-check the values - perpendicular
; distances and heading changes must be <= 255 (dm/degree) with
; min <= max <= extreme, speed <= 0xFFFF cm/s ("FC_Stat: ... too big in
; registry", strings 0x79241c..0x7929a4) - so the old extreme=500 failed all
; three accessor inits.  Values below satisfy those constraints.
[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\FC_STAT\APP_CONFIG\STAT_TASK1\DOUGLAS_PEUCKER_BREAD_CRUMBS]
"TOTAL_NBOF_BREAD_CRUMBS"=dword:00000064
