"BOARD_NAME"="LCN2 KAI"

; DAPIAPP.OUT application id used by DAPIAPP s32InitApp07.
; The firmware region registry containing the real DAPI app is encrypted, so this
; compatibility entry provides only the startup keys checked by scd/ail init.
