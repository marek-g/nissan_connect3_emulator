"MSG_COUNT_INTERMEDIATE_MBX"=dword:00000050
"WATCHDOG_INTERVALL"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\FC_STAT\APP_CONFIG]
; `scd_s32GetThreadConfiguration` (PROCNAV `0x34f71a`) reads these three values under
; the app's APP_CONFIG key while resolving a thread config; any miss zeroes the
; config and fails `rtf::tclComponent::s32SetupThreads` (-1), which makes STAT's
; bOnInit fail and the CCA adapter stuck in INITIALIZED. Values follow the TIMA
; bring-up defaults seen in the trace output (ms-per-tick 2500, 120/900 ticks).
"WDG_MSPERTICK"=dword:000009c4
"WTICKS"=dword:00000078
"MAXWTICKS"=dword:00000384

[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\FC_STAT\SERVICES\FC_STAT]
"SERVICEID"=dword:00000016

; TIMA (traffic-info component) initializes right after the FC apps and opens
; its five KTIMA config sub-keys through the same encrypted hive; without them
; `bOnInit` retries in a ~150 ms loop and the serialized component bring-up
; never reaches HMI_NAVSERVER (the NavIF server the wait-popup waits for).
; Empty keys are enough for the opens to succeed; whatever values TIMA then
; queries log as plain misses, which its code tolerates.
[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\TIMA]
[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\TIMA\APP_CONFIG]
[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\TIMA\APP_CONFIG\KTIMA]
; bOnInit queries every value below; a miss makes the open key look invalid
; and TIMA retries (~1 s, 33x in a 30 s run), serializing component bring-up
; before HMI_NAVSERVER.  Sizes: dword values are u32, the string ones are the
; 32/41-byte buffers the queries request.  Values are neutral defaults - the
; memory device/dir stay empty so TIMA skips persistence instead of touching
; a host path.
"CTRL_SWITCH_KEY"=dword:00000000
"CTRL_SWITCH_VALUE"=dword:00000000
"CUST_SPEC_CONF_DIR_NAME"=""

