"REGLOADED"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\PROCDAPI\DAPIAPP]
"APPID"=dword:00000007
"MAXMCOUNT"=dword:00000078
"MAXMSIZE"=dword:00000008

[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\PROCDAPI\DAPIAPP\AIF_CONFIG]
