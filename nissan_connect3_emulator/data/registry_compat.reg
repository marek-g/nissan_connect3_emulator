[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\FUNCTIONAL_COMPONENT\HMINAVSERVER\SERVICES\HMINAVSERVER]
"SERVICEID"=dword:00000027

; r791c: the navif (prochmi FI client, app 0x0121) command-subscriber loop
; (enavi_tclCCACommandSubscriber::C1) registers its 16 USE_CCA_SRV_* CL
; services; the first table entry (0x0a) and POSITION (0x1e) resolve to the
; external sensor provider (SENSORFI), the remaining 14 must resolve to the
; FI navigation server app that owns the USE_CCA_SRV_* configuration -
; HMINAVSERVER.  The real device publishes them from the encrypted NAVAPP
; hive; without them the SCD lookup fails for every entry and bStartupNavIF
; aborts at table index 1 (service 0x2c) with 0x8000000b, keeping the enavi
; state machine out of state 5 (no keyboard page).  HMINAVSERVER (0x24) is
; not emulated as an application, so its registrations are answered by the
; cca-server emulation like the HMI-side ones (visible in the log).

[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\FUNCTIONAL_COMPONENT\HMINAVSERVER\SERVICES\HMINAVSERVER_CL002C]
"SERVICEID"=dword:0000002c

