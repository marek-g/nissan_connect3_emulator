; APPID lookups (fix103): PROCESS\NAVAPP\TIMA and
; FUNCTIONAL_COMPONENT\HMINAVSERVER both retry their APPID query 5x.  TIMA is
; the component hosted by APP03 (shared KTIMA schema), so its app id is the
; compiled-in s32InitApp03 constant 3; HMI_NAVSERVER must answer with 0x24
; because that is the server app id the HMI's static SCD map sends the
; svc-0x27 (NAVI FI) registrations to (mbx_36 in the traces).
[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\TIMA]
"APPID"=dword:00000003
"MAXMCOUNT"=dword:00000078
"MAXMSIZE"=dword:00000008

; r793 experiment (f140, reverted): APPID 0x11c (FC_LBS, live since
; ON_TENGINE=1, image that holds the FI server classes) made the navif
; registrations land on a queue PROCNAV's bring-up never waits on, and worse,
; PROCNAV's own FC_LBS init hangs when scd_bGetAppIdFromServiceId resolves a
; service it *consumes* (0x06/0x07/0x1f) to its own pending app ("App 284"
; instead of "App 36" - the vStartApp chain never reaches FC_LBS APP_THREAD).
; PROCNAV's real map must keep these services external: HMI_NAVSERVER is a
; separate host process (0x24), and app ids {1,3,19,22,23,284}+0x400 are all
; the emulated binaries compile in.
[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\FUNCTIONAL_COMPONENT\HMINAVSERVER]
"APPID"=dword:00000024
"MAXMCOUNT"=dword:00000078
"MAXMSIZE"=dword:00000008

[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\FUNCTIONAL_COMPONENT\HMINAVSERVER\AIF_CONFIG]
