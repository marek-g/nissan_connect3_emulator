; The sensorfi service the GPS provider answers. r388 ground truth:
; STAT_tclThread::_msgEntries keys every sensorfi handler by service 0xa
; (fn 0x8001/0x8008 property-status family, fn 0x201 method result), so the
; published SERVICEID must be 0xa or `pfFindMessageMap` never hits. scd_
; bGetAppIdFromServiceId (via scd_tclServiceAppMap::bReadData) walks
; PROCESS/*/*/SERVICES/* comparing SERVICEID; with no entry publishing it
; PROCNAV drops every GpsDataStatus right after the amt field reads (r215
; trace: accept -> field helper x2 -> registry ioctl -> discard). APPID 21 is
; an external provider id: replies would route to mbx_21, which the host queue
; store creates on demand and nothing must consume.
[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\SENSORFI]
"APPID"=dword:00000015
"MAXMCOUNT"=dword:00000078
"MAXMSIZE"=dword:00000008

[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\SENSORFI\AIF_CONFIG]
"MSG_COUNT_INTERMEDIATE_MBX"=dword:00000050
"WATCHDOG_INTERVALL"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\SENSORFI\APP_CONFIG]

[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\SENSORFI\SERVICES\SENSORFI]
"SERVICEID"=dword:0000000a

; posfi (navigation position) service publication. The map engine's PortControl
; Navi client handler registers as client of service 0x1e (bInit registers
; {0x1e fn 0x10/0x13, 0x2c, 0x1f, 0x37}); scd/ADM service-to-app resolution
; walks PROCESS/*/*/SERVICES/*, so without this entry the REGISTER for 0x1e
; can never be answered and the engine never routes NavPositionStatus to
; vHandleNavPosition (the only feed of the CCP that anchors the map view).
; APPID mirrors SENSORFI's external-provider id so the REGISTER is posted to
; the host queue store (mbx_21) instead of an app that would reject it.
[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\POSFI]
"APPID"=dword:00000015
"MAXMCOUNT"=dword:00000078
"MAXMSIZE"=dword:00000008

[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\POSFI\AIF_CONFIG]
"MSG_COUNT_INTERMEDIATE_MBX"=dword:00000050
"WATCHDOG_INTERVALL"=dword:00000000

[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\POSFI\APP_CONFIG]

[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\NAVAPP\POSFI\SERVICES\POSFI]
"SERVICEID"=dword:0000001e

; The device-manager FI media-info status message announces the navigation medium under the
; name `/dev/cryptnav` (measured in `dap_tclMediaInfoCtrl`: one entry, type 6 = fully
; available), and DAPI registers a medium only when a manager was told that name through
; APP_CONFIG/DEVICES: `vEvalDeviceConfig` (0x822630) reads `DEVICE_NAV_n` (medium name,
; string), `DEVICE_NAV_n_PRM` (device path, string) and `DEVICE_NAV_n_MAX_NUM_FD` (dword)
; and passes them to `bAddNavDevice`.  With the key missing (the firmware's real DAPI
; region registry `ni2k_*/DAPIAPP.ERG` is encrypted) every manager keeps empty medium
; names, so the regionselection context never holds a medium, `GETREGIONOUTLINES` answers
; 0x305, the region-profile outlines never load and no `GetBlockIDs` request can ever be
; answered with block ids.
[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\PROCDAPI\DAPIAPP\APP_CONFIG\DEVICES]
"DEFAULT_DEV"="/dev/cryptnav"
"DEVICE_ONLINE_LINKING"="/dev/cryptnav"
; Deliberately no DEVICE_ONLINE_LINK_PRM / DEVICE_ONLINE_LINK_MAXNUM_FD: `vEvalDeviceConfig`
; stores the medium name in the configuration field either way, but only when all three are
; present it also calls `bAddNavDevice` - and registering a second nav device for the same
; medium breaks the map worker's rnw reference (`this + 0x180` stops being a valid rnw
; communication object), so the `type=0x6 fct=0x84` GetRegProfOutline sub-job is never
; routed, `DATA/CONNECT/RNW/NAV_ROOT.DAT` is never read and the rnw region profiles stay
; invalid, which is what `u16SendUniqueIdList` needs before it can answer block ids.
"DEVICE_OL_SOURCE_DEVICE"="/dev/cryptnav"
"DEVICE_NAV_1"="/dev/cryptnav"
"DEVICE_NAV_1_PRM"="/dev/media/sda1"
"DEVICE_NAV_1_MAX_NUM_FD"=dword:00000004

[HKEY_LOCAL_MACHINE\SOFTWARE\BLAUPUNKT\PROCESS\DAPIAPP\DATA_SERVER\APP_CONFIG\DEVICES]
"DEFAULT_DEV"="/dev/cryptnav"
"DEVICE_ONLINE_LINKING"="/dev/cryptnav"
"DEVICE_OL_SOURCE_DEVICE"="/dev/cryptnav"
"DEVICE_NAV_1"="/dev/cryptnav"
"DEVICE_NAV_1_PRM"="/dev/media/sda1"
"DEVICE_NAV_1_MAX_NUM_FD"=dword:00000004
"DEVICE_NAV_2"="/dev/cryptnav"
"DEVICE_NAV_2_PRM"="/dev/media/sda1"
"DEVICE_NAV_2_MAX_NUM_FD"=dword:00000004
; `rs_tclManager`'s constructors (0x858d40 / 0x858e58) take their two medium names from the
; configuration: `+0x470` (the medium regionselection reads region outlines from) is
; `dap_tclConfiguration::szGetOnlineLinkDev()` = `DEVICE_ONLINE_LINKING`, and `+0x474` is
; `szGetOLSourceDevice()` = `DEVICE_OL_SOURCE_DEVICE`.  A name only becomes a medium if the
; device manager also announces it, so both point at the announced `/dev/cryptnav`.
"DEVICE_ONLINE_LINKING"="/dev/cryptnav"
"DEVICE_OL_SOURCE_DEVICE"="/dev/cryptnav"

; ---------------------------------------------------------------------------
; Round-2 seeds after TIMA's KTIMA branch unblocked the component chain
